{
    "manifest_version": 2,
    "name": "Corporate Earnings",
    "version": "3.3.4",
    "description": "Displays earnings and fundamentals in an easy-to-analyze format (MarketSmith Style)",
    "icons": {
        "128": "src/images/icon128.png"
    },
    "content_scripts": [
        {
            "matches": [
                "https://seekingalpha.com/symbol/*/earnings",
                "https://www.zacks.com/stock/research/*/earnings-calendar",
                "https://finance.yahoo.com/quote/*/futures*",
                "https://finance.yahoo.com/quote/*"
            ],
            "js": [
                "src/js/constants.js",
                "src/js/helpers.js",
                "src/js/core.js"
            ],
            "run_at": "document_end"
        }
    ],
    "browser_action": {
        "default_icon": "src/images/icon.png",
        "default_popup": "src/html/popup.html"
    },
    "options_ui": {
        "page": "src/html/options.html"
    },
    "background": {
        "scripts": ["src/js/background.js"]
    },
    "permissions": [
        "storage",
        "tabs",
        "https://*.finviz.com/*",
        "https://*.zacks.com/*",
        "https://*.seekingalpha.com/*",
        "https://*.yahoo.com/*",
        "https://query1.finance.yahoo.com/*",
        "https://query2.finance.yahoo.com/*"
    ]
}
